{
  "name": "jiin-seok-landing-page",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 15.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tailwindcss": "tailwindcss",
    "prepare": "husky install",
    "lint": "eslint . --fix && stylelint '**/*.css' --fix",
    "test": "vitest run",
    "resume": "tsx scripts/resume/generate.ts",
    "site-pdf": "tsx scripts/resume/generate-site-pdf.ts",
    "format": "prettier --write .",
    "correct": "pnpm format && pnpm lint",
    "update-dev": "git fetch origin && git rebase origin/dev",
    "pre-push": "pnpm correct && pnpm build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "stylelint": {
    "extends": "./lint/.stylelintrc.json"
  },
  "prettier": "./lint/.prettierrc.json",
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "pdfjs-dist": "^6.1.200",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.10.0"
}
